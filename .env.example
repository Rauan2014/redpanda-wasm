# ============================================================================
# Configuração de Monetização e Apoio — Panda3DS Web
# Copie este arquivo para `.env` (desenvolvimento local) ou adicione as
# variáveis no painel da Vercel (Settings -> Environment Variables).
# ============================================================================

# 1. APOIO DIRETO (Pix / Ko-fi / GitHub Sponsors) — Sempre ativo no botão "❤ Apoiar"
VITE_PIX_KEY=sua-chave-pix-aqui@email.com
VITE_KOFI_URL=https://ko-fi.com/seu_usuario
VITE_GITHUB_SPONSORS_URL=https://github.com/seu_usuario

# 2. OPÇÃO A: A-ADS (https://aads.com) — Mais simples, sem KYC, paga em Cripto/BTC
# Crie um Ad Unit do tipo "Adaptive" no A-Ads e cole apenas o número do ID abaixo:
VITE_AADS_UNIT_ID=

# 3. OPÇÃO B: ADSTERRA (https://adsterra.com) — Banner 728x90 (Sem Pop-under)
# No painel da Adsterra, adicione seu site e escolha APENAS "Banner 728x90".
# No código gerado (`atOptions`), copie a chave hexadecimal de 32 caracteres (`'key': '...'`):
VITE_ADSTERRA_KEY=
# (Opcional) Domínio do script invoke.js fornecido pela Adsterra:
VITE_ADSTERRA_HOST=www.highperformanceformat.com
# (Opcional) Ou URL direta de iframe/banner customizado (Adsterra / Monetag):
VITE_ADSTERRA_BANNER_URL=

# 4. OPÇÃO C: GOOGLE ADSENSE (Opcional — apenas se tiver conta aprovada no futuro)
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT=0000000000

# Provedor prioritário: 'auto' (detecta automaticamente), 'aads', 'adsterra', 'adsense' ou 'support'
VITE_AD_PROVIDER=auto
